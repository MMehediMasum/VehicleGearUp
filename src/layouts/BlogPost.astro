---
import { slugify } from '../utils/slug';
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { styleFor } from '../utils/topicStyles';

 
type Props = CollectionEntry<'blog'>['data'] & {readingTime?: number; related?: CollectionEntry<'blog'>[];};

const { title, description, pubDate, updatedDate, heroImage, author, categories, topic, readingTime, related = [], noindex } = Astro.props;

const ts = styleFor(topic ?? '');
const authorEntry = author ? await getEntry('authors', author) : undefined;

const postUrl = Astro.url.toString();
const absoluteHeroImage = heroImage ? new URL(heroImage, Astro.site).toString() : undefined;

const articleJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description: description,
	...(absoluteHeroImage && { image: [absoluteHeroImage] }),
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: authorEntry
		? { '@type': 'Person', name: authorEntry.data.name }
		: { '@type': 'Organization', name: SITE_TITLE },
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		...(Astro.site && { logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', Astro.site).toString() } }),
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': postUrl,
	},
};

const firstCategory = categories?.[0];
const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: new URL('/', Astro.site).toString(),
		},
		...(firstCategory
			? [
					{
						'@type': 'ListItem',
						position: 2,
						name: firstCategory,
						item: new URL(
							`/categories/${slugify(firstCategory)}/`,
							Astro.site
						).toString(),
					},
				]
			: []),
		{
			'@type': 'ListItem',
			position: firstCategory ? 3 : 2,
			name: title,
			item: postUrl,
		},
	],
};
---
 
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} noindex={noindex} />
		<script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0 0 2rem;
			}
			/* ---------- Article header ---------- */
			.post-head {
				position: relative;
				color: #fff;
				padding: 2.6rem 1.2rem 3.4rem;
				background:
					radial-gradient(ellipse 50% 100% at 100% 0%, color-mix(in srgb, var(--c2) 45%, transparent), transparent 65%),
					linear-gradient(155deg, #0c131d 0%, var(--c1) 140%);
			}
			.post-head::after {
				content: ''; position: absolute; left: 0; right: 0; bottom: 0.9rem; height: 4px; opacity: 0.5;
				background: repeating-linear-gradient(90deg, var(--amber) 0 38px, transparent 38px 76px);
			}
			.post-head-inner { width: 780px; max-width: 100%; margin: 0 auto; }
			.crumbs {
				display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 1.2rem;
				font-size: 0.82rem; color: rgba(255, 255, 255, 0.7);
			}
			.crumbs a { color: inherit; text-decoration: none; box-shadow: none; }
			.crumbs a:hover { color: var(--amber); box-shadow: none; }
			.chip {
				display: inline-block; padding: 0.22rem 0.8rem; margin-bottom: 0.9rem; border-radius: 999px;
				background: var(--amber); color: #1b1303 !important; font-size: 0.78rem; font-weight: 700;
				text-decoration: none; box-shadow: none !important;
			}
			.post-head h1 {
				color: #fff; margin: 0 0 1rem;
				font-size: clamp(2.2rem, 5.2vw, 3.6rem); line-height: 1.06; text-align: left;
			}
			.meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem; font-size: 0.9rem; color: rgba(255, 255, 255, 0.82); }
			.meta .by { display: inline-flex; align-items: center; gap: 0.6rem; }
			.meta .by img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 2px solid var(--amber); }
			.meta .by strong { color: #fff; display: block; line-height: 1.2; }
			.meta .by small { display: block; font-size: 0.78rem; opacity: 0.8; line-height: 1.2; }
			.meta .sep { width: 4px; height: 4px; border-radius: 50%; background: var(--amber); }
			.meta em { font-style: normal; opacity: 0.85; }

			/* ---------- Hero image ---------- */
			.hero-image { width: 780px; max-width: calc(100% - 2.4rem); margin: -1.8rem auto 0; position: relative; z-index: 2; }
			.hero-image img {
				display: block; width: 100%; height: auto; aspect-ratio: 2 / 1; object-fit: cover;
				border-radius: 16px; box-shadow: var(--box-shadow); background: rgb(var(--gray-light));
			}

			/* ---------- Article body ---------- */
			.prose { width: 780px; max-width: calc(100% - 2.4rem); margin: 0 auto; padding: 2.2rem 0 0; color: rgb(var(--gray-dark)); }
			.content { font-size: 1.1rem; line-height: 1.85; }
			.content :global(p) { margin: 0 0 1.4em; }
			.content :global(h2) {
				font-size: clamp(1.9rem, 3.6vw, 2.5rem); margin: 2em 0 0.5em;
				padding-left: 0.6em; border-left: 5px solid var(--accent); scroll-margin-top: 5.5rem;
			}
			.content :global(h3) { font-size: 1.7rem; margin: 1.7em 0 0.4em; scroll-margin-top: 5.5rem; }
			.content :global(h4) { font-size: 1.4rem; margin: 1.5em 0 0.4em; }
			.content :global(ul), .content :global(ol) { padding-left: 1.4em; margin: 0 0 1.5em; }
			.content :global(li) { margin-bottom: 0.5em; }
			.content :global(li)::marker { color: var(--accent); font-weight: 700; }
			.content :global(a) { color: var(--accent); font-weight: 600; text-underline-offset: 3px; }
			.content :global(p a) { box-shadow: none; text-decoration: underline; text-decoration-thickness: 2px; text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent); }
			.content :global(p a:hover) { color: var(--accent-dark); background: var(--accent-soft); box-shadow: none; }
			.content :global(img) { display: block; margin: 1.8em auto; border-radius: 12px; box-shadow: 0 6px 20px rgba(10, 16, 28, 0.15); }
			.content :global(blockquote) {
				margin: 1.8em 0; padding: 1.1rem 1.4rem; border-left: 5px solid var(--amber);
				background: rgb(var(--gray-light)); border-radius: 0 14px 14px 0; font-size: 1.05em;
			}
			.content :global(blockquote p:last-child) { margin-bottom: 0; }
			.content :global(table) { display: block; overflow-x: auto; margin: 1.8em 0; font-size: 0.95em; border: 1px solid rgba(var(--gray), 0.25); border-radius: 12px; }
			.content :global(strong) { color: rgb(var(--black)); }

			/* ---------- Footer-of-article blocks ---------- */
			.author-box {
				display: flex; align-items: center; gap: 1.1rem; margin: 1.5rem 0; padding: 1.3rem 1.4rem;
				border-radius: 18px; background: rgb(var(--gray-light)); border-left: 6px solid var(--amber);
			}
			.author-box img { width: 76px; height: 76px; border-radius: 50%; object-fit: cover; flex: none; border: 3px solid var(--amber); }
			.author-box .label { margin: 0; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(var(--gray)); font-weight: 700; }
			.author-box .name { margin: 0.1rem 0 0.2rem; font-family: var(--display); font-weight: 700; font-size: 1.6rem; line-height: 1.1; color: rgb(var(--black)); }
			.author-box .bio { margin: 0; font-size: 0.92rem; line-height: 1.55; color: rgb(var(--gray)); }
			.author-box .more { display: inline-block; margin-top: 0.4rem; font-size: 0.88rem; font-weight: 700; text-decoration: none; box-shadow: none; }
			.categories { margin: 1.2em 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
			.categories a {
				padding: 0.3em 0.9em; border-radius: 999px; background: var(--accent-soft); color: var(--accent);
				text-decoration: none; font-size: 0.85rem; font-weight: 600; box-shadow: none; transition: background 0.15s ease, color 0.15s ease;
			}
			.categories a:hover { background: var(--accent); color: #fff; box-shadow: none; }
			:global(:root[data-theme='dark']) .categories a:hover { color: #0d0f14; }

			@media (max-width: 560px) {
				.post-head { padding: 1.8rem 1rem 3rem; }
				.content { font-size: 1.04rem; }
				.author-box { flex-direction: column; text-align: center; }
			}
		</style>
	</head>

	<body>
		<Header />
		<main style={`--c1:${ts.c1};--c2:${ts.c2}`}>
			<article>
				<header class="post-head">
					<div class="post-head-inner">
						<nav class="crumbs" aria-label="Breadcrumb">
							<a href="/">Home</a>
							{topic && (<><span>/</span><a href={`/topic/${slugify(topic)}/`}>{topic}</a></>)}
							{firstCategory && (<><span>/</span><a href={`/categories/${slugify(firstCategory)}/`}>{firstCategory}</a></>)}
						</nav>
						{firstCategory && <a class="chip" href={`/categories/${slugify(firstCategory)}/`}>{firstCategory}</a>}
						<h1>{title}</h1>
						<div class="meta">
							{authorEntry && (
								<span class="by">
									{authorEntry.data.avatar && <img src={authorEntry.data.avatar} alt={authorEntry.data.name} width="40" height="40" />}
									<span>
										<strong>{authorEntry.data.name}</strong>
										<small>ASE-Certified Master Technician</small>
									</span>
								</span>
							)}
							<span class="sep"></span>
							<FormattedDate date={pubDate} />
							{readingTime && (<><span class="sep"></span><span>{readingTime} min read</span></>)}
							{updatedDate && (<><span class="sep"></span><em>Updated <FormattedDate date={updatedDate} /></em></>)}
						</div>
					</div>
				</header>

				{heroImage && (
					<div class="hero-image">
						<img src={heroImage} alt="" loading="eager" width="1020" height="510" />
					</div>
				)}

				<div class="prose">
					<div class="content">
						<slot />
					</div>

					<hr />

					{authorEntry && (
						<div class="author-box">
							{authorEntry.data.avatar && <img src={authorEntry.data.avatar} alt={authorEntry.data.name} width="76" height="76" />}
							<div>
								<p class="label">Written by</p>
								<p class="name">{authorEntry.data.name}</p>
								<p class="bio">{authorEntry.data.bio}</p>
								<a class="more" href="/about/">More about Herbert →</a>
							</div>
						</div>
					)}

					{categories && categories.length > 0 && (
						<div class="categories">
							{categories.map((category) => (
								<a href={`/categories/${slugify(category)}/`}>{category}</a>
							))}
						</div>
					)}

					{related.length > 0 && (
						<section class="related-posts">
							<h2>Related Posts</h2>
							<ul>
								{related.map((r) => (
									<li><a href={`/${r.id}/`}>{r.data.title}</a></li>
								))}
							</ul>
						</section>
					)}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
