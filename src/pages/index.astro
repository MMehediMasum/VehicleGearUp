---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const topics = [...new Set(allPosts.map((post) => post.data.topic).filter(Boolean))].sort();
const topicCategorySets = new Map();
for (const post of allPosts) {
	if (!post.data.topic) continue;
	if (!topicCategorySets.has(post.data.topic)) {
		topicCategorySets.set(post.data.topic, new Set());
	}
	for (const category of post.data.categories ?? []) {
		topicCategorySets.get(post.data.topic).add(category);
	}
}
const topicCounts = new Map(
	[...topicCategorySets.entries()].map(([topic, set]) => [topic, set.size])
);

const latestPosts = allPosts.slice(0, 9);

function thumbUrl(query: string) {
	const q = encodeURIComponent(query);
	return `https://tse1.mm.bing.net/th?q=${q}&w=474&h=274&c=7`;
}

function formatDate(date: Date) {
	return new Intl.DateTimeFormat('en-US', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	}).format(date);
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1100px, 92vw);
				margin: 0 auto;
			}

			/* ---------- Hero ---------- */
			.hero {
				position: relative;
				overflow: hidden;
				background:
					radial-gradient(ellipse 60% 85% at 12% 15%, rgba(84, 142, 155, 0.22), transparent 60%),
					radial-gradient(ellipse 55% 75% at 88% 10%, rgba(224, 138, 95, 0.16), transparent 60%),
					radial-gradient(ellipse 70% 60% at 50% 115%, rgba(84, 142, 155, 0.14), transparent 65%),
					linear-gradient(180deg, #fbf8f2 0%, #f3ede0 100%);
				border-radius: 24px;
				padding: 4.5rem 2.5rem;
				margin: 1.5rem auto 3.5rem;
				text-align: center;
			}
			.hero::before {
				content: '';
				position: absolute;
				top: 0;
				right: 0;
				bottom: 0;
				left: 0;
				z-index: 0;
				background-image: url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%27130%27 height=%27130%27%3E%3Cg fill=%27%233b636d%27%3E%3Cellipse cx=%2765%27 cy=%2782%27 rx=%2724%27 ry=%2719%27/%3E%3Cellipse cx=%2737%27 cy=%2748%27 rx=%2711%27 ry=%2714%27/%3E%3Cellipse cx=%2765%27 cy=%2736%27 rx=%2711%27 ry=%2714%27/%3E%3Cellipse cx=%2793%27 cy=%2748%27 rx=%2711%27 ry=%2714%27/%3E%3C/g%3E%3C/svg%3E");
				background-size: 130px 130px;
				opacity: 0.05;
				pointer-events: none;
			}
			.hero-content {
				position: relative;
				z-index: 1;
				/* Hero background is always a light cream gradient, in both
				   light and dark site themes, so its text must stay fixed
				   dark colors rather than following the --black/--gray-dark
				   theme variables (which flip to light colors in dark mode
				   and would become invisible here). */
				color: #14171f;
			}
			.hero h1 {
				font-size: clamp(2rem, 4vw, 2.9rem);
				line-height: 1.15;
				margin: 0 0 0.6em;
				max-width: 22ch;
				margin-left: auto;
				margin-right: auto;
				color: #14171f;
			}
			.hero p {
				max-width: 52ch;
				margin: 0 auto;
				color: #4a5164;
				font-size: 1.1rem;
			}

			/* ---------- Topic cards ---------- */
			.section-heading {
				font-size: 1.5rem;
				margin: 0 0 1.2rem;
			}
			.topic-row {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				gap: 1.5rem;
				list-style: none;
				margin: 0 0 3.5rem;
				padding: 0;
			}
			.topic-card {
				position: relative;
				display: block;
				border-radius: 16px;
				overflow: hidden;
				aspect-ratio: 4 / 3;
				text-decoration: none;
				color: white;
				box-shadow: 0 1px 3px rgba(var(--gray), 25%);
				transition: transform 0.2s ease;
			}
			.topic-card:hover {
				transform: translateY(-3px);
			}
			.topic-card img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.topic-card .overlay {
				position: absolute;
				inset: 0;
				background: linear-gradient(180deg, rgba(15, 18, 25, 0) 40%, rgba(15, 18, 25, 0.75) 100%);
			}
			.topic-card .label {
				position: absolute;
				left: 1.2rem;
				bottom: 1rem;
				right: 1.2rem;
			}
			.topic-card .label h3 {
				margin: 0;
				font-size: 1.4rem;
			}
			.topic-card .label span {
				font-size: 0.85rem;
				opacity: 0.85;
			}

			/* ---------- Latest posts ---------- */
			.post-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
				gap: 1.8rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-card {
				display: flex;
				flex-direction: column;
				text-decoration: none;
				color: rgb(var(--black));
			}
			.post-thumb {
				width: 100%;
				aspect-ratio: 474 / 274;
				border-radius: 12px;
				overflow: hidden;
				background: rgb(var(--gray-light));
				margin-bottom: 0.8rem;
			}
			.post-thumb img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				transition: transform 0.3s ease;
			}
			.post-card:hover .post-thumb img {
				transform: scale(1.04);
			}
			.post-category {
				font-size: 0.8rem;
				color: var(--accent-dark);
				font-weight: 600;
				margin-bottom: 0.25rem;
			}
			.post-title {
				font-size: 1.1rem;
				line-height: 1.35;
				font-weight: 700;
				margin: 0 0 0.4rem;
			}
			.post-card:hover .post-title {
				color: var(--accent);
			}
			.post-date {
				margin-top: auto;
				padding-top: 0.3rem;
				font-size: 0.82rem;
				color: rgb(var(--gray));
			}

			@media (max-width: 640px) {
				.hero {
					padding: 2.2rem 1.4rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-content">
					<h1>One home for everything your cat, dog or bird needs</h1>
					<p>{SITE_DESCRIPTION}</p>
				</div>
			</section>

			<section>
				<h2 class="section-heading">Browse by pet</h2>
				<ul class="topic-row">
					{
						topics.map((topic) => (
							<li>
								<a class="topic-card" href={`/topic/${topic.toLowerCase().replace(/\s+/g, '-')}/`}>
									<img src={thumbUrl(topic)} alt="" loading="lazy" onerror="this.style.display='none'" />
									<div class="overlay" />
									<div class="label">
										<h3>{topic}</h3>
										<span>{topicCounts.get(topic)} categories</span>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section>
				<h2 class="section-heading">Latest articles</h2>
				<ul class="post-grid">
					{
						latestPosts.map((post) => (
							<li>
								<a class="post-card" href={`/${post.id}/`}>
									<div class="post-thumb">
										<img
											src={thumbUrl(`${post.data.topic ?? ''} ${post.data.title}`)}
											alt=""
											loading="lazy"
											onerror="this.style.display='none'"
										/>
									</div>
									{post.data.categories?.[0] && (
										<span class="post-category">{post.data.categories[0]}</span>
									)}
									<h3 class="post-title">{post.data.title}</h3>
									<span class="post-date">{formatDate(post.data.pubDate)}</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
