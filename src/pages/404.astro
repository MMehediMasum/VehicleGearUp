---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Page Not Found - ${SITE_TITLE}`} description="This page could not be found." />
		<style>
			.not-found {
				text-align: center;
				padding: 4em 1em;
			}
			.not-found .code {
				font-family: var(--display);
				font-weight: 700;
				font-size: 8rem;
				margin: 0;
				color: var(--amber);
				text-shadow: 4px 4px 0 rgba(var(--gray), 0.25);
				line-height: 1;
			}
			.not-found h1 {
				margin-top: 0.3em;
			}
			.not-found p {
				color: rgb(var(--gray));
				font-size: 1.1em;
			}
			.not-found .home-link {
				display: inline-block;
				margin-top: 1.5em;
				padding: 0.7em 1.6em;
				background: var(--amber);
				color: #1b1303;
				border-radius: 10px;
				text-decoration: none;
				font-weight: 700;
				transition: background 0.2s ease;
			}
			.not-found .home-link:hover {
				background: #ffc24d;
				color: #1b1303;
			}
			@media (max-width: 480px) {
				.not-found .code {
					font-size: 5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="not-found">
				<p class="code">404</p>
				<h1>This page could not be found</h1>
				<p>The page you are looking for may have been removed or never existed.</p>
				<hr />
				<a class="home-link" href="/">Return to the home page</a>
			</div>
		</main>
		<Footer />
	</body>
</html>