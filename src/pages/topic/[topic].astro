---
import { slugify } from '../../utils/slug';
import { styleFor } from '../../utils/topicStyles';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const allPosts = await getCollection('blog');
	const topics = [...new Set(allPosts.map((post) => post.data.topic).filter(Boolean))];
	return topics.map((topic) => ({
		params: { topic: slugify(topic) },
		props: { topicName: topic },
	}));
}

const { topicName } = Astro.props;
const allPosts = await getCollection('blog');
const postsInTopic = allPosts.filter((post) => post.data.topic === topicName);
const s = styleFor(topicName);

const categoryCounts = new Map();
for (const post of postsInTopic) {
	for (const category of post.data.categories ?? []) {
		categoryCounts.set(category, (categoryCounts.get(category) ?? 0) + 1);
	}
}
const categories = [...categoryCounts.entries()].sort((a, b) => a[0].localeCompare(b[0]));

function thumbUrl(category: string) {
	const q = encodeURIComponent(`${topicName} ${category}`);
	return `https://tse1.mm.bing.net/th?q=${q}&w=474&h=274&c=7`;
}

const description = `Browse ${categories.length} ${categories.length === 1 ? 'category' : 'categories'} and ${postsInTopic.length} ${postsInTopic.length === 1 ? 'guide' : 'guides'} on ${topicName.toLowerCase()} from Vehicle GearUp, written by ASE-Certified Master Technician Herbert Langham.`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${topicName} - ${SITE_TITLE}`} description={description} />
		<style>
			main {
				width: min(1100px, 92vw);
				max-width: none;
				padding: 1.8rem 0 3rem;
			}
			.crumbs {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin: 0 0 1rem;
				font-size: 0.85rem;
				color: rgb(var(--gray));
			}
			.crumbs a { color: inherit; text-decoration: none; }
			.crumbs a:hover { color: var(--accent); }

			.topic-hero {
				position: relative;
				overflow: hidden;
				color: #fff;
				border-radius: 24px;
				padding: 3rem 2.6rem 3.6rem;
				margin-bottom: 2.4rem;
				background:
					radial-gradient(ellipse 55% 90% at 100% 0%, color-mix(in srgb, var(--c2) 55%, transparent), transparent 65%),
					linear-gradient(155deg, #0c131d 0%, var(--c1) 135%);
				box-shadow: 0 18px 40px rgba(10, 16, 28, 0.22);
			}
			.topic-hero::after {
				content: '';
				position: absolute;
				left: 0; right: 0; bottom: 1.1rem; height: 4px; opacity: 0.55;
				background: repeating-linear-gradient(90deg, var(--amber) 0 38px, transparent 38px 76px);
			}
			.badge {
				width: 64px; height: 64px; border-radius: 18px;
				display: grid; place-items: center;
				background: rgba(255, 255, 255, 0.16);
				border: 1px solid rgba(255, 255, 255, 0.3);
				margin-bottom: 1.1rem;
			}
			.badge :global(svg) { width: 32px; height: 32px; }
			.eyebrow {
				margin: 0 0 0.3rem; font-size: 0.8rem; letter-spacing: 0.16em;
				text-transform: uppercase; color: var(--amber); font-weight: 700;
			}
			.topic-hero h1 {
				font-size: clamp(2.4rem, 5.5vw, 3.8rem);
				line-height: 1.04;
				margin: 0 0 0.45em;
				color: #fff;
				max-width: 18ch;
			}
			.stats { display: flex; flex-wrap: wrap; gap: 0.6rem; }
			.stats span {
				font-size: 0.85rem; font-weight: 600; padding: 0.35rem 0.9rem;
				border-radius: 999px; background: rgba(255, 255, 255, 0.12); color: #eef2f9;
			}

			.section-heading {
				font-size: 2rem; margin: 0 0 1.2rem; padding-left: 0.8rem;
				border-left: 5px solid var(--amber); line-height: 1.1;
			}
			.category-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
				gap: 1.4rem;
				list-style: none; margin: 0; padding: 0;
			}
			.category-grid li { margin: 0; }
			.category-card {
				position: relative;
				display: flex; flex-direction: column; height: 100%;
				border-radius: 16px; overflow: hidden;
				background: rgb(var(--gray-light));
				border: 1px solid rgba(var(--gray), 0.2);
				text-decoration: none; color: rgb(var(--black));
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			.category-card:hover { transform: translateY(-4px); box-shadow: var(--box-shadow); }
			.category-card::after {
				content: ''; position: absolute; left: 0; bottom: 0; height: 4px; width: 0;
				background: var(--amber); transition: width 0.35s ease;
			}
			.category-card:hover::after, .category-card:focus-visible::after { width: 100%; }
			.thumb {
				position: relative; width: 100%; aspect-ratio: 474 / 274; overflow: hidden;
				background: linear-gradient(150deg, var(--c1), var(--c2));
			}
			.thumb img {
				width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 0;
				transition: transform 0.4s ease;
			}
			.category-card:hover .thumb img { transform: scale(1.06); }
			.card-body { display: flex; flex-direction: column; flex-grow: 1; padding: 0.9rem 1.1rem 1.1rem; }
			.cat-name {
				margin: 0; font-size: 1.5rem; line-height: 1.12;
				min-height: calc(1.12em * 2);
				display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
			}
			.count {
				margin-top: auto; padding-top: 0.7rem; font-size: 0.85rem; font-weight: 600;
				color: var(--accent);
			}
			.category-card:hover .cat-name { color: var(--accent); }
			.empty { text-align: center; color: rgb(var(--gray)); }
			@media (max-width: 560px) {
				.topic-hero { padding: 2.2rem 1.3rem 3rem; }
				.category-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem; }
				.cat-name { font-size: 1.25rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/">Home</a><span>/</span><a href="/#topics">Topics</a><span>/</span><span>{topicName}</span>
			</nav>
			<section class="topic-hero" style={`--c1:${s.c1};--c2:${s.c2}`}>
				<div class="badge" set:html={s.icon} />
				<p class="eyebrow">Topic</p>
				<h1>{topicName}</h1>
				<div class="stats">
					<span>{categories.length} {categories.length === 1 ? 'category' : 'categories'}</span>
					<span>{postsInTopic.length} {postsInTopic.length === 1 ? 'guide' : 'guides'}</span>
				</div>
			</section>

			<h2 class="section-heading">Pick a category</h2>
			{
				categories.length === 0 ? (
					<p class="empty">No categories found under this topic yet.</p>
				) : (
					<ul class="category-grid" style={`--c1:${s.c1};--c2:${s.c2}`}>
						{categories.map(([category, count]) => (
							<li>
								<a class="category-card" href={`/categories/${slugify(category)}/`}>
									<div class="thumb">
										<img src={thumbUrl(category)} alt="" loading="lazy" onerror="this.style.display='none'" />
									</div>
									<div class="card-body">
										<h3 class="cat-name">{category}</h3>
										<span class="count">{count} {count === 1 ? 'guide' : 'guides'} →</span>
									</div>
								</a>
							</li>
						))}
					</ul>
				)
			}
		</main>
		<Footer />
	</body>
</html>
