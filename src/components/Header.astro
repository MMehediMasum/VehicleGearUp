---
import { slugify } from '../utils/slug';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const posts = await getCollection('blog');
const topics = [...new Set(posts.map((post) => post.data.topic).filter(Boolean))].sort();
---

<header>
	<nav>
		<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
			<span class="brand-mark" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13l2-6h14l2 6v5H3z"/><circle cx="7.5" cy="18" r="1.8"/><circle cx="16.5" cy="18" r="1.8"/></svg>
			</span>
			<span class="brand-text">Vehicle <b>GearUp</b></span>
		</a>
		<div class="internal-links" id="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<div class="dropdown">
				<button
					id="categories-trigger"
					class="dropdown-trigger"
					type="button"
					aria-haspopup="true"
					aria-expanded="false"
				>
					Topics
				</button>
				<ul id="categories-menu" class="dropdown-menu">
					{
						topics.map((topic) => (
							<li>
								<a href={`/topic/${slugify(topic)}/`}>
									{topic}
								</a>
							</li>
						))
					}
				</ul>
			</div>
			<HeaderLink href="/about/">About</HeaderLink>
			<HeaderLink href="/contact/">Contact</HeaderLink>
		</div>
		<div class="header-actions">
			<button id="theme-toggle" aria-label="Toggle dark mode" type="button">
				<span id="theme-icon">🌙</span>
			</button>
			<button id="mobile-menu-toggle" class="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false" type="button">
				<span></span><span></span><span></span>
			</button>
		</div>
	</nav>
</header>
<script>
	const themeButton = document.getElementById('theme-toggle');
	const themeIcon = document.getElementById('theme-icon');

	function syncIcon() {
		const current = document.documentElement.getAttribute('data-theme');
		if (themeIcon) themeIcon.textContent = current === 'dark' ? '☀️' : '🌙';
	}
	syncIcon();

	themeButton?.addEventListener('click', () => {
		const current = document.documentElement.getAttribute('data-theme');
		const next = current === 'dark' ? 'light' : 'dark';
		document.documentElement.setAttribute('data-theme', next);
		localStorage.setItem('theme', next);
		syncIcon();
	});

	const catTrigger = document.getElementById('categories-trigger');
	const catMenu = document.getElementById('categories-menu');

	catTrigger?.addEventListener('click', (e) => {
		e.stopPropagation();
		const isOpen = catMenu?.classList.toggle('open');
		catTrigger.setAttribute('aria-expanded', String(!!isOpen));
	});

	document.addEventListener('click', () => {
		catMenu?.classList.remove('open');
		catTrigger?.setAttribute('aria-expanded', 'false');
	});

	const mobileToggle = document.getElementById('mobile-menu-toggle');
	const internalLinks = document.getElementById('internal-links');

	mobileToggle?.addEventListener('click', (e) => {
		e.stopPropagation();
		const isOpen = internalLinks?.classList.toggle('mobile-open');
		mobileToggle.setAttribute('aria-expanded', String(!!isOpen));
		mobileToggle.classList.toggle('active', !!isOpen);
	});

	internalLinks?.addEventListener('click', (e) => {
		const target = e.target;
		if (target instanceof HTMLElement && target.tagName === 'A') {
			internalLinks.classList.remove('mobile-open');
			mobileToggle?.setAttribute('aria-expanded', 'false');
			mobileToggle?.classList.remove('active');
		}
	});

	document.addEventListener('click', (e) => {
		if (
			internalLinks?.classList.contains('mobile-open') &&
			!internalLinks.contains(e.target) &&
			e.target !== mobileToggle
		) {
			internalLinks.classList.remove('mobile-open');
			mobileToggle?.setAttribute('aria-expanded', 'false');
			mobileToggle?.classList.remove('active');
		}
	});
</script>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		margin: 0;
		padding: 0 1.2em;
		background: #0c131d;
		border-bottom: 3px solid var(--amber);
		box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(1100px, 100%);
		margin: 0 auto;
		min-height: 64px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		text-decoration: none;
		color: #fff;
	}
	.brand:hover {
		color: #fff;
	}
	.brand-mark {
		width: 38px;
		height: 38px;
		border-radius: 10px;
		display: grid;
		place-items: center;
		background: var(--amber);
		color: #1b1303;
		transition: transform 0.2s ease;
	}
	.brand:hover .brand-mark {
		transform: rotate(-6deg) scale(1.05);
	}
	.brand-mark svg {
		width: 24px;
		height: 24px;
	}
	.brand-text {
		font-family: var(--display);
		font-size: 1.65rem;
		font-weight: 700;
		letter-spacing: 0.01em;
		line-height: 1;
	}
	.brand-text b {
		color: var(--amber);
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.2rem;
	}
	.internal-links > :global(a),
	.dropdown-trigger {
		position: relative;
		padding: 1.3em 0.8em;
		color: #dfe6f1;
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-weight: 600;
		font-size: 0.8rem;
		transition: color 0.2s ease;
	}
	.internal-links > :global(a:hover),
	.internal-links > :global(a.active),
	.dropdown-trigger:hover,
	.dropdown-trigger[aria-expanded='true'] {
		color: #fff;
	}
	.internal-links > :global(a::after),
	.dropdown-trigger::after {
		content: '';
		position: absolute;
		left: 0.8em;
		right: 0.8em;
		bottom: 0.7em;
		height: 3px;
		border-radius: 2px;
		background: var(--amber);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.25s ease;
	}
	.internal-links > :global(a:hover::after),
	.dropdown-trigger:hover::after {
		transform: scaleX(1);
	}
	.internal-links > :global(a.active::after) {
		transform: scaleX(1);
	}
	.dropdown {
		position: relative;
	}
	.dropdown-trigger {
		background: none;
		border: none;
		font-family: inherit;
		cursor: pointer;
	}
	.dropdown-trigger::before {
		content: '';
		display: inline-block;
		order: 2;
	}
	.dropdown-menu {
		position: absolute;
		top: calc(100% - 0.4rem);
		left: 0;
		min-width: 270px;
		width: max-content;
		margin: 0;
		padding: 0.5em;
		list-style: none;
		background: #fff;
		border-radius: 14px;
		border-top: 4px solid var(--amber);
		box-shadow: 0 18px 40px rgba(8, 12, 20, 0.35);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-6px);
		transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
		z-index: 60;
	}
	.dropdown-menu.open {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}
	.dropdown-menu li {
		margin: 0;
	}
	.dropdown-menu a {
		display: block;
		padding: 0.6em 0.9em;
		border-radius: 8px;
		color: #1b2433;
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95rem;
		white-space: nowrap;
	}
	.dropdown-menu a:hover {
		background: #fff3dc;
		color: #9a3412;
	}
	.header-actions {
		display: flex;
		align-items: center;
	}
	#theme-toggle {
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 10px;
		cursor: pointer;
		font-size: 1.1rem;
		padding: 0.4rem 0.55rem;
		line-height: 1;
		transition: background 0.2s ease;
	}
	#theme-toggle:hover {
		background: rgba(255, 255, 255, 0.18);
	}
	.mobile-menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 4px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.6em;
		margin-left: 0.3em;
	}
	.mobile-menu-toggle span {
		display: block;
		width: 22px;
		height: 2px;
		background: #fff;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}
	.mobile-menu-toggle.active span:nth-child(1) {
		transform: translateY(6px) rotate(45deg);
	}
	.mobile-menu-toggle.active span:nth-child(2) {
		opacity: 0;
	}
	.mobile-menu-toggle.active span:nth-child(3) {
		transform: translateY(-6px) rotate(-45deg);
	}
	:root[data-theme='dark'] header {
		background: #080c13;
	}
	:root[data-theme='dark'] .dropdown-menu {
		background: #161b26;
	}
	:root[data-theme='dark'] .dropdown-menu a {
		color: #e2e8f0;
	}
	:root[data-theme='dark'] .dropdown-menu a:hover {
		background: rgba(255, 176, 32, 0.14);
		color: var(--amber);
	}

	@media (max-width: 760px) {
		nav {
			flex-wrap: wrap;
			min-height: 58px;
		}
		.brand-text {
			font-size: 1.45rem;
		}
		.mobile-menu-toggle {
			display: flex;
		}
		.internal-links {
			display: none;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			width: 100%;
			order: 3;
			padding: 0.3em 0 1em 0;
			border-top: 1px solid rgba(255, 255, 255, 0.12);
		}
		.internal-links.mobile-open {
			display: flex;
		}
		.internal-links > :global(a),
		.dropdown-trigger {
			padding: 0.9em 0;
			text-align: left;
		}
		.internal-links > :global(a::after),
		.dropdown-trigger::after {
			display: none;
		}
		.dropdown {
			width: 100%;
		}
		.dropdown-trigger {
			width: 100%;
		}
		.dropdown-menu {
			position: static;
			min-width: 0;
			box-shadow: none;
			border-top: 0;
			background: rgba(255, 255, 255, 0.06);
			opacity: 1;
			visibility: visible;
			transform: none;
			display: none;
			width: auto;
		}
		.dropdown-menu a {
			color: #dfe6f1;
			white-space: normal;
		}
		.dropdown-menu a:hover {
			background: rgba(255, 176, 32, 0.15);
			color: var(--amber);
		}
		.dropdown-menu.open {
			display: block;
		}
	}
</style>
