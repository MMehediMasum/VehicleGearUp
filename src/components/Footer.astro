---
const today = new Date();

const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const footerLinks = [
	{ href: '/about/', label: 'About Us' },
	{ href: '/contact/', label: 'Contact' },
	{ href: '/privacy-policy/', label: 'Privacy Policy' },
	{ href: '/disclosure/', label: 'Disclosure' },
	{ href: '/terms/', label: 'Terms' },
].filter((link) => normalize(link.href) !== normalize(Astro.url.pathname));
---

<footer>
	<div class="footer-inner">
		<div class="footer-grid">
			<div class="f-brand">
				<a class="brand" href="/">
					<span class="brand-mark" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13l2-6h14l2 6v5H3z"/><circle cx="7.5" cy="18" r="1.8"/><circle cx="16.5" cy="18" r="1.8"/></svg>
					</span>
					<span class="brand-text">Vehicle <b>GearUp</b></span>
				</a>
				<p class="tagline">Straight talk from under the hood.</p>
				<p class="blurb">
					Practical car-care guides by Herbert Langham, ASE-Certified Master Technician, so you can handle the basics and spot a bad repair quote.
				</p>
			</div>

			<nav class="f-col" aria-label="Footer">
				<h2>Explore</h2>
				<ul>
					<li><a href="/">Home</a></li>
					{footerLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
				</ul>
			</nav>

			<address class="f-col">
				<h2>Contact</h2>
				<ul>
					<li>
						<span class="k">Email</span>
						<a href="mailto:herbertalangham@gmail.com">herbertalangham@gmail.com</a>
					</li>
					<li>
						<span class="k">Address</span>
						2457 Oakridge Drive<br />Columbus, OH 43221, USA
					</li>
				</ul>
				<div class="social-links">
					<a href="https://www.facebook.com/HerbertLangham/" target="_blank" rel="nofollow noopener noreferrer">
						<span class="sr-only">Follow Herbert Langham on Facebook</span>
						<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22">
							<path
								fill="currentColor"
								d="M9.25 16V8.703h2.45l.367-2.845H9.25V4.04c0-.824.229-1.386 1.411-1.386h1.508V.11A20.21 20.21 0 0 0 9.97 0C7.795 0 6.305 1.327 6.305 3.764v2.094H3.846v2.845h2.459V16h2.945z"
							></path>
						</svg>
					</a>
					<a href="mailto:herbertalangham@gmail.com">
						<span class="sr-only">Email Herbert Langham</span>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="22" height="22"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
					</a>
				</div>
			</address>
		</div>

		<p class="affiliate-note">
			Vehicle GearUp is a participant in the Amazon Services LLC Associates Program. As an Amazon
			Associate, we earn from qualifying purchases. <a href="/disclosure/">Learn more</a>.
		</p>
		<p class="copy">&copy; {today.getFullYear()} Vehicle GearUp. All rights reserved.</p>
	</div>
</footer>

<style>
	footer {
		margin-top: 4rem;
		padding: 3.2rem 1.2rem 2rem;
		background: #0c131d;
		border-top: 4px solid var(--amber);
		color: #aebbd0;
		position: relative;
	}
	footer::before {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: 10px;
		height: 3px;
		opacity: 0.35;
		background: repeating-linear-gradient(90deg, var(--amber) 0 38px, transparent 38px 76px);
	}
	.footer-inner {
		width: min(1100px, 100%);
		margin: 0 auto;
	}
	.footer-grid {
		display: grid;
		grid-template-columns: 1.4fr 0.8fr 1.2fr;
		gap: 2.6rem;
		text-align: left;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: #fff;
	}
	.brand:hover { color: #fff; }
	.brand-mark {
		width: 36px;
		height: 36px;
		border-radius: 10px;
		display: grid;
		place-items: center;
		background: var(--amber);
		color: #1b1303;
	}
	.brand-mark svg { width: 22px; height: 22px; }
	.brand-text { font-family: var(--display); font-size: 1.6rem; font-weight: 700; line-height: 1; }
	.brand-text b { color: var(--amber); }
	.tagline {
		margin: 1rem 0 0.3rem;
		font-family: var(--display);
		font-size: 1.25rem;
		color: var(--amber);
		letter-spacing: 0.02em;
	}
	.blurb { margin: 0; font-size: 0.92rem; line-height: 1.65; max-width: 38ch; }
	.f-col h2 {
		margin: 0 0 0.9rem;
		font-family: var(--display);
		font-size: 1.15rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #fff;
	}
	.f-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
	.f-col li { margin: 0; font-size: 0.93rem; line-height: 1.55; }
	address { font-style: normal; }
	.k {
		display: block;
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #7e8da6;
		font-weight: 700;
	}
	footer a { color: #dfe6f1; text-decoration: none; }
	footer a:hover { color: var(--amber); }
	.f-col li a { border-bottom: 1px solid rgba(255, 255, 255, 0.18); }
	.f-col li a:hover { border-color: var(--amber); }
	.social-links { display: flex; gap: 0.7rem; margin-top: 1.1rem; }
	.social-links a {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: rgba(255, 255, 255, 0.08);
		border: 0;
		transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
	}
	.social-links a:hover { background: var(--amber); color: #1b1303; transform: translateY(-2px); }
	.affiliate-note {
		margin: 2.4rem 0 0.6rem;
		padding-top: 1.4rem;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		font-size: 0.8rem;
		line-height: 1.6;
		text-align: center;
	}
	.affiliate-note a { text-decoration: underline; }
	.copy { margin: 0; font-size: 0.8rem; text-align: center; color: #7e8da6; }

	@media (max-width: 800px) {
		.footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
		.f-brand { grid-column: 1 / -1; }
	}
	@media (max-width: 480px) {
		.footer-grid { grid-template-columns: 1fr; }
	}
</style>
